{
  "name": "daigan-ops-console",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "代肝价格查询 · 私用运营台 —— 本地优先的运营工作台",
  "author": "DAIGANG",
  "main": "desktop/main.mjs",
  "scripts": {
    "start": "node server.mjs",
    "local": "node server.mjs --local",
    "desktop": "electron .",
    "desktop:dev": "vite build && electron .",
    "dist": "npm run build && electron-builder --win --config desktop/electron-builder.yml",
    "dist:portable": "npm run build && electron-builder --win portable --config desktop/electron-builder.yml",
    "dist:installer": "npm run build && electron-builder --win nsis --config desktop/electron-builder.yml",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "setup": "npm ci && npm run build",
    "prestart": "npm run build",
    "prelocal": "npm run build",
    "test": "node scripts/checks/smoke-run.mjs",
    "test:ui": "node scripts/checks/ui-smoke.mjs",
    "test:glass": "node scripts/checks/glass-check.mjs",
    "test:icon-probe": "node scripts/checks/icon-probe-check.mjs",
    "test:key": "node scripts/checks/game-key-check.mjs",
    "test:vision-python": "node scripts/checks/vision-python-check.mjs",
    "vision:matrix": "node scripts/checks/vision-matrix.mjs",
    "test:bili": "node scripts/checks/bili-scan-check.mjs",
    "test:bili-apply": "node scripts/checks/bili-apply-check.mjs",
    "check": "node scripts/checks/check.mjs && npm run test && npm run build",
    "check:full": "npm run check && npm run test:ui && npm run test:glass",
    "migration:check": "node scripts/migration/check.mjs",
    "migration:export": "node scripts/migration/export.mjs",
    "erpnext:preview": "node scripts/erpnext/preview.mjs",
    "erpnext:bundle": "node scripts/erpnext/preview.mjs",
    "erpnext:check": "node scripts/erpnext/bundle-check.mjs",
    "erpnext:preflight": "node scripts/erpnext/preflight.mjs",
    "erpnext:sync": "node scripts/erpnext/sync.mjs",
    "erpnext:sync:transactions": "node scripts/erpnext/sync-transactions.mjs",
    "erpnext:sync:outbox": "node scripts/erpnext/outbox.mjs",
    "erpnext:reconcile": "node scripts/erpnext/reconcile.mjs",
    "backup:restic": "node scripts/tools/restic-backup.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "browser-image-compression": "^2.0.2",
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "vite": "8.3.2"
  }
}
