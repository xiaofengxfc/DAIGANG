{
  "name": "daigan-ops-console",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "代肝价格查询 · 私用运营台 —— 本地优先的运营工作台",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "local": "node server.mjs --local",
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "setup": "npm ci && npm run build",
    "prestart": "npm run build",
    "prelocal": "npm run build",
    "test": "node scripts/smoke-run.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "check": "node scripts/check.mjs && npm run test && npm run build",
    "check:full": "npm run check && npm run test:ui",
    "migration:check": "node scripts/migration-check.mjs",
    "migration:export": "node scripts/migration-export.mjs",
    "erpnext:preview": "node scripts/erpnext-preview.mjs",
    "erpnext:bundle": "node scripts/erpnext-preview.mjs",
    "erpnext:check": "node scripts/erpnext-bundle-check.mjs",
    "erpnext:preflight": "node scripts/erpnext-preflight.mjs",
    "erpnext:sync": "node scripts/erpnext-sync.mjs",
    "erpnext:sync:transactions": "node scripts/erpnext-sync-transactions.mjs",
    "erpnext:sync:outbox": "node scripts/erpnext-outbox.mjs",
    "erpnext:reconcile": "node scripts/erpnext-reconcile.mjs",
    "backup:restic": "node scripts/restic-backup.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "lucide-react": "1.50.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.2"
  }
}
